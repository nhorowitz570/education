NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix any of these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
# Optional price ceilings per million tokens when changing the text model.
MODEL_INPUT_USD_PER_MILLION=0.20
MODEL_OUTPUT_USD_PER_MILLION=1.20
# Direct OpenAI access is used only for Live and speech.
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-live-1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
VOICE_PROVIDER=live
AI_MONTHLY_LIMIT_USD=20
AI_PROJECT_MONTHLY_LIMIT_USD=40
VOICE_SESSION_LIMIT_SECONDS=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as base64. For server-side OAuth credential encryption.
TOKEN_ENCRYPTION_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
