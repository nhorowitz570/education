NEXT_PUBLIC_APP_URL=https://edu.nhorowitz.co
# Optional extra origins allowed to call the API (comma-separated).
APP_ALLOWED_ORIGINS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix any of these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI. Text models (Luna, Sol, Astra) go through OpenRouter; GPT-Live voice and
# embeddings use OpenAI directly. AI_PROVIDER=openai sends text to OpenAI too.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_MODEL_FAST=gpt-6-luna
AI_MODEL_PRIMARY=gpt-6-sol
AI_MODEL_REASONING=gpt-6-astra
AI_MODEL_EMBEDDING=text-embedding-3-small
# USD per million tokens: input,cached input,output. Only used when the
# provider doesn't report cost (OpenRouter reports the billed amount).
AI_PRICE_FAST=0.10,0.01,0.50
AI_PRICE_PRIMARY=2,0.20,10
AI_PRICE_REASONING=10,1,50
# Optional runaway guard per account per month. Unset = unmetered (still logged).
AI_MONTHLY_LIMIT_USD=
OPENAI_VOICE_MODEL=gpt-live-1
VOICE_SESSION_LIMIT_SECONDS=900

# Vercel Cron sends this as a bearer token to /api/cron.
CRON_SECRET=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# iPhone app. Push goes through APNs with an auth key (.p8) from the Apple
# Developer account (Keys → Apple Push Notifications service). Paste the key
# file's contents into APNS_PRIVATE_KEY (literal \n line breaks are fine).
# Push to iPhones stays off until all three are set.
APNS_KEY_ID=
APNS_TEAM_ID=WB5QDXNHR8
APNS_PRIVATE_KEY=
# Optional: the app's bundle id (default co.nhorowitz.fieldwork) and the team
# used in /.well-known/apple-app-site-association for passkeys.
APNS_TOPIC=
APPLE_TEAM_ID=
