{
  "name": "fieldwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "ios:project": "cd ios && xcodegen -q",
    "ios:build": "cd ios && xcodegen -q && xcodebuild -project Fieldwork.xcodeproj -scheme Fieldwork -destination 'generic/platform=iOS Simulator' -derivedDataPath build -skipPackagePluginValidation build -quiet",
    "ios:open": "cd ios && xcodegen -q && open Fieldwork.xcodeproj"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "idb": "8.0.3",
    "next": "16.3.5",
    "openai": "7.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.8.1",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "type": "module"
}
